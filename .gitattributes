# Všetky textové súbory ukladať a checkoutovať s LF
* text=auto eol=lf

*.c        text eol=lf
*.h        text eol=lf
*.sh       text eol=lf
*.md       text eol=lf
*.scala    text eol=lf
*.rc       text eol=lf
Makefile   text eol=lf
Doxyfile   text eol=lf

# Binárne súbory
*.pdf      binary
*.png      binary
*.jpg      binary
*.zip      binary
*.tgz      binary
